OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_REASONING_EFFORT=low
OPENAI_MODEL_LIGHT=gpt-5-mini
OPENAI_REASONING_EFFORT_LIGHT=minimal
# 비용 추정 단가(백만 토큰당 USD, 입력/출력)
OPENAI_PRICES=gpt-5=1.25/10,gpt-5-mini=0.25/2
# 표기 갈림 카드의 참고 직역. 비면 직역을 띄우지 않는다
DEEPL_AUTH_KEY=
STORAGE_TYPE=supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=xlsx
SUPABASE_DB_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
TRANSLATE_BATCH_SIZE=30
LENGTH_RATIO_DEFAULT=1.0
UPLOAD_MAX_MB=50
LLM_CONCURRENCY=8
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api
